{
  "info": {
    "name": "DripPay API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth Register",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Test User\"\n}"
        }
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@drippay.app\",\n  \"password\": \"Demo1234!\"\n}"
        }
      }
    },
    {
      "name": "Wallet Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/wallets/me"
      }
    },
    {
      "name": "Demo Deposit",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/wallets/demo-deposits",
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 1000\n}" }
      }
    },
    {
      "name": "SafeTransfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "demo-key-001" }
        ],
        "url": "{{baseUrl}}/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientWalletId\": \"DRIPXXXXXXXX\",\n  \"amount\": 100,\n  \"note\": \"Thanks\"\n}"
        }
      }
    }
  ]
}
