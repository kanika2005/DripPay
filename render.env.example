# Copy these keys into Render → Web Service → Environment (values are examples only).

# Option 1 — full JDBC URL (replace mysql-a1b2c3 with your MySQL private hostname)
DB_URL=jdbc:mysql://mysql-a1b2c3:3306/drippay?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=drippay
DB_PASSWORD=your-mysql-password

# Option 2 — omit DB_URL and use:
# MYSQL_HOST=mysql-a1b2c3
# MYSQL_PORT=3306
# MYSQL_DATABASE=drippay
# DB_USERNAME=drippay
# DB_PASSWORD=your-mysql-password

JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=https://your-frontend.onrender.com

# Do NOT use placeholders like YOUR_MYSQL_HOST — deploy will fail.
